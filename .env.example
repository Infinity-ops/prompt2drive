# Copy to .env and fill in what your chosen backends need. Never commit .env.

# --- Backend selection -----------------------------------------------------
#   openai       GPT-4o for text and vision (paid API)
#   huggingface  HF Inference API for text, local vLLM for vision
#   local        a local vLLM server for text and vision (no API key)
P2D_TEXT_BACKEND=openai
P2D_VISION_BACKEND=local

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
# OPENAI_TEXT_MODEL=gpt-4o
# OPENAI_VISION_MODEL=gpt-4o

# --- Hugging Face ------------------------------------------------------------
HF_TOKEN=hf_your-token-here
# HF_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Local vLLM (OpenAI-compatible) -------------------------------------------
# Both model names must equal the server's --served-model-name exactly.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLLM_TEXT_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# --- Pipeline ----------------------------------------------------------------
# Pass threshold tau for the Semantic Alignment Score (paper: 0.75)
P2D_VERIFICATION_THRESHOLD=0.75
# Independent VLM calls per verification, majority-voted (paper: 3)
P2D_VERIFIER_N_SAMPLES=3
# Hardware profile: default | low_vram_2gb | low_vram_2gb_signals
P2D_HARDWARE_PROFILE=low_vram_2gb
