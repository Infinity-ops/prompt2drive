# Copy this file to .env and fill in the key(s) for whichever backend(s)
# you plan to use. Never commit the real .env file.

# --- OpenAI backend (proprietary, paid per-token) -----------------------
OPENAI_API_KEY=sk-your-key-here

# --- Hugging Face backend (open-weight, free or PRO account) ------------
HUGGINGFACE_API_TOKEN=hf_your-token-here

# --- Backend selection ----------------------------------------------------
# "openai" or "huggingface". Can be overridden per-CLI-call with --backend.
P2D_TEXT_BACKEND=openai
P2D_VISION_BACKEND=openai

# Optional: override the specific models used by the Hugging Face backend.
# Defaults if unset: Meta-Llama-3.1-8B-Instruct (text) / Qwen2-VL-7B-Instruct (vision)
HF_TEXT_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
HF_VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct

# Optional pipeline overrides
P2D_VERIFICATION_THRESHOLD=0.72
P2D_MAX_ITERATIONS=3
